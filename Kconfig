mainmenu "debugprobe-zephyr"

config PROBE_PRODUCT_STRING
	string "USB product string"
	default "Debug Probe (CMSIS-DAP)" if BOARD_RPI_DEBUG_PROBE
	default "Debugprobe on Pico (CMSIS-DAP)" if BOARD_RPI_PICO || BOARD_RPI_PICO2
	default "Debugprobe (CMSIS-DAP)"

choice PROBE_SWD_BACKEND
	prompt "SWD driver backend"
	default PROBE_SWD_BITBANG
	help
	  Which SWD port driver backs the DAP engine.

config PROBE_SWD_NULL
	bool "Null (no SWD; bring-up only)"

config PROBE_SWD_BITBANG
	bool "Zephyr GPIO bitbang (zephyr,swdp-gpio)"

config PROBE_SWD_PIO
	bool "PIO-accelerated (raspberrypi,swdp-pio)"

endchoice

config PROBE_MSP430_SBW
	bool "MSP430 Spy-Bi-Wire programming (vendor command 0x90)"
	default y
	depends on PROBE_SWD_PIO && PIO_RPI_PICO && DT_HAS_DEBUGPROBE_SBW_PIO_ENABLED
	select SBW_PIO
	help
	  Program MSP430 CPUXv2 flash devices (MSP430F5529) over Spy-Bi-Wire,
	  using the SWD pins. Adds a CMSIS-DAP vendor command; the USB
	  descriptors do not change. See docs/MSP430_SBW.md.

# The SBW vendor command runs on the USB device thread and nests deeper than
# the SWD path (engine -> Session -> Cpuxv2 -> SbwTap -> port -> PIO driver).
# Zephyr's default of 1024 bytes leaves no margin for it.
config USBD_THREAD_STACK_SIZE
	default 2048 if PROBE_MSP430_SBW

# The out-of-tree PIO driver Kconfigs (drivers/Kconfig, which pulls in dp_pio
# and sbw_pio) are sourced via the Zephyr module mechanism (zephyr/module.yml
# -> build.kconfig), not rsource'd here, so they are registered alongside the
# drivers' CMakeLists in the module loop. Sourcing them both ways would
# redefine SWDP_PIO.

source "Kconfig.zephyr"
