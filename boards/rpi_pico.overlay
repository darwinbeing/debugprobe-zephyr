#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Route the PIO SWD pins to the PIO0 function (the Zephyr way, via pinctrl).
 * SWCLK=GP2 (PIO output), SWDIO=GP3 (shared in/out: input-enable so `in pins`
 * can sample it, pull-up for the idle-high SWD bus).
 */
&pinctrl {
	swd_pio_default: swd_pio_default {
		clk_pins {
			pinmux = <PIO0_P2>;
		};
		dio_pins {
			pinmux = <PIO0_P3>;
			input-enable;
			bias-pull-up;
		};
	};

	/* Target UART (uart1): TX=GP4, RX=GP5 -- the CDC-ACM bridge endpoint. */
	uart1_default: uart1_default {
		tx_group {
			pinmux = <UART1_TX_P4>;
		};
		rx_group {
			pinmux = <UART1_RX_P5>;
			input-enable;
		};
	};

	/* Autobaud pin-handoff states for uart1 RX (GP5). Two single-state
	 * dev-configs (the robust two-node approach): while measuring, route GP5
	 * to PIO0 so the frequency-counter SM sees the edges; on stop, route it
	 * back to UART1 so the bridge's UART RX works again. Both keep
	 * input-enable so the pad samples the incoming line. */
	autobaud_pio_pins: autobaud_pio_pins {
		rx_group {
			pinmux = <PIO0_P5>;
			input-enable;
		};
	};
	autobaud_uart_pins: autobaud_uart_pins {
		rx_group {
			pinmux = <UART1_RX_P5>;
			input-enable;
		};
	};
};

/* Enable uart1 as the bridge's hardware side. The board defaults the console
 * to uart0 (GP0/GP1), so uart1 is free to be the target UART.
 */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

/* Enable PIO0 so the misc PIO HAL (PIO_RPI_PICO) builds, which the dp_pio
 * driver compiles against, and so the raspberrypi,swdp-pio instance can run.
 */
&pio0 {
	status = "okay";
};

&dma { status = "okay"; };

/ {
	/* CDC-ACM (USB) <-> uart1 (target) bridge is now a custom C++ UartBridge
	 * (src/uart_bridge.cpp) that binds cdc_acm_uart0 and uart1 directly, so
	 * there is no zephyr,uart-bridge DT node here anymore.
	 */

	/* Autobaud pin-handoff anchors (compatible debugprobe,autobaud). The
	 * autobaud module (src/autobaud/autobaud.cpp) references these two nodes
	 * via DT_NODELABEL to obtain the two single-state pinctrl dev-configs:
	 * autobaud_pio routes uart1 RX (GP5) to PIO0 while measuring;
	 * autobaud_uart routes it back to UART1 on stop. rx-pin carries the RX
	 * GPIO number for the PIO SM config. No driver binds these; the binding
	 * exists only for the pinctrl + rx-pin DT codegen. */
	autobaud_pio: autobaud_pio {
		compatible = "debugprobe,autobaud";
		rx-pin = <5>;
		piodev = <&pio0>;
		pinctrl-0 = <&autobaud_pio_pins>;
		pinctrl-names = "default";
	};
	autobaud_uart: autobaud_uart {
		compatible = "debugprobe,autobaud";
		rx-pin = <5>;
		pinctrl-0 = <&autobaud_uart_pins>;
		pinctrl-names = "default";
	};

	/* Two SWD backends share these pins (GP2=SWCLK, GP3=shared SWDIO,
	 * GP1=nRESET). Exactly one is enabled at a time: the PIO node is the
	 * default (CONFIG_PROBE_SWD_PIO=y); to use bitbang, flip both the
	 * Kconfig choice and these two status values.
	 */
	swd_bitbang: swd_bitbang {
		compatible = "zephyr,swdp-gpio";
		clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		port-write-cycles = <2>;
		status = "disabled";
	};

	swd_pio: swd_pio {
		compatible = "raspberrypi,swdp-pio";
		piodev = <&pio0>;
		pinctrl-0 = <&swd_pio_default>;
		pinctrl-names = "default";
		clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		swclk-pin = <2>;
		swdio-pin = <3>;
		status = "okay";
	};

	/* Single onboard LED (led0 = GP25): use it as the USB-connected
	 * indicator. There are no separate DAP connect/run LEDs on this board,
	 * so those aliases are absent and their helpers no-op.
	 */
	aliases {
		usb-connected-led = &led0;
	};
};
