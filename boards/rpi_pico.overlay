#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Route the PIO SWD pins to the PIO0 function (the Zephyr way, via pinctrl).
 * SWCLK=GP2 (PIO output), SWDIO=GP3 (shared in/out: input-enable so `in pins`
 * can sample it, pull-up for the idle-high SWD bus).
 */
&pinctrl {
	swd_pio_default: swd_pio_default {
		clk_pins {
			pinmux = <PIO0_P2>;
		};
		dio_pins {
			pinmux = <PIO0_P3>;
			input-enable;
			bias-pull-up;
		};
	};

	/* Target UART (uart1): TX=GP4, RX=GP5 -- the CDC-ACM bridge endpoint. */
	uart1_default: uart1_default {
		tx_group {
			pinmux = <UART1_TX_P4>;
		};
		rx_group {
			pinmux = <UART1_RX_P5>;
			input-enable;
		};
	};
};

/* Enable uart1 as the bridge's hardware side. The board defaults the console
 * to uart0 (GP0/GP1), so uart1 is free to be the target UART.
 */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

/* Enable PIO0 so the misc PIO HAL (PIO_RPI_PICO) builds, which the dp_pio
 * driver compiles against, and so the raspberrypi,swdp-pio instance can run.
 */
&pio0 {
	status = "okay";
};

/ {
	/* CDC-ACM (USB) <-> uart1 (target) bridge: Zephyr's zephyr,uart-bridge
	 * driver wires cdc_acm_uart0 to the hardware uart1, copying bytes both
	 * ways and propagating the host's line coding to uart1.
	 */
	uart_bridge0: uart-bridge0 {
		compatible = "zephyr,uart-bridge";
		peers = <&cdc_acm_uart0 &uart1>;
	};

	/* Two SWD backends share these pins (GP2=SWCLK, GP3=shared SWDIO,
	 * GP1=nRESET). Exactly one is enabled at a time: the PIO node is the
	 * default (CONFIG_PROBE_SWD_PIO=y); to use bitbang, flip both the
	 * Kconfig choice and these two status values.
	 */
	swd_bitbang: swd_bitbang {
		compatible = "zephyr,swdp-gpio";
		clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		port-write-cycles = <2>;
		status = "disabled";
	};

	swd_pio: swd_pio {
		compatible = "raspberrypi,swdp-pio";
		piodev = <&pio0>;
		pinctrl-0 = <&swd_pio_default>;
		pinctrl-names = "default";
		clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		swclk-pin = <2>;
		swdio-pin = <3>;
		status = "okay";
	};
};
