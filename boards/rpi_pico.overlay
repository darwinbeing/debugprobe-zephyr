&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Enable PIO0 so the misc PIO HAL (PIO_RPI_PICO) builds, which the dp_pio
 * driver compiles against. The raspberrypi,swdp-pio instance is added in Task 5.
 */
&pio0 {
	status = "okay";
};

/ {
	swd_dev: swd_dev {
		compatible = "zephyr,swdp-gpio";
		clk-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		port-write-cycles = <2>;
	};
};
