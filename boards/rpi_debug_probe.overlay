#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Route the Debug Probe's PIO SWD pins to PIO0 (the Zephyr way, via pinctrl).
 * SWCLK=GP12 (output), SWDIO=GP14 (output only -- the probe has a separate
 * input), SWDI=GP13 (the read pin: input-enable + pull-up).
 */
&pinctrl {
	swd_pio_default: swd_pio_default {
		clk_pins {
			pinmux = <PIO0_P12>;
		};
		dio_pins {
			pinmux = <PIO0_P14>;
		};
		din_pins {
			pinmux = <PIO0_P13>;
			input-enable;
			bias-pull-up;
		};
	};

	/* Console UART (uart0): TX=GP0, RX=GP1. The board defaults the console
	 * to uart1, but uart1 is the bridge target here, so the console moves to
	 * uart0 (chosen below) and needs its own pinctrl (the board DTS only
	 * defines uart1_default).
	 */
	uart0_default: uart0_default {
		tx_group {
			pinmux = <UART0_TX_P0>;
		};
		rx_group {
			pinmux = <UART0_RX_P1>;
			input-enable;
		};
	};

	/* Autobaud pin-handoff states for uart1 RX (GP5, same as the Picos). Two
	 * single-state dev-configs (the robust two-node approach): while
	 * measuring, route GP5 to PIO0 so the frequency-counter SM sees the
	 * edges; on stop, route it back to UART1 so the bridge's UART RX works
	 * again. Both keep input-enable so the pad samples the incoming line. */
	autobaud_pio_pins: autobaud_pio_pins {
		rx_group {
			pinmux = <PIO0_P5>;
			input-enable;
		};
	};
	autobaud_uart_pins: autobaud_uart_pins {
		rx_group {
			pinmux = <UART1_RX_P5>;
			input-enable;
		};
	};
};

/* Move the console/shell off uart1 (the board DTS chose uart1) so the bridge
 * owns uart1 exclusively, and enable uart0 as the console UART.
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Enable PIO0 so the misc PIO HAL (PIO_RPI_PICO) builds, which the dp_pio
 * driver compiles against, and so the raspberrypi,swdp-pio instance can run.
 */
&pio0 {
	status = "okay";
};

/ {
	/* uart1 is already enabled (status=okay, uart1_default pinctrl) in the
	 * board DTS and was the console -- move the console/shell to uart0 so the
	 * CDC-ACM <-> uart1 bridge owns uart1.
	 */
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	/* CDC-ACM (USB) <-> uart1 (target) bridge is now a custom C++ UartBridge
	 * (src/uart_bridge.cpp) that binds cdc_acm_uart0 and uart1 (already okay
	 * in the board DTS) directly, so there is no zephyr,uart-bridge DT node
	 * here anymore.
	 */

	/* Autobaud pin-handoff anchors (compatible debugprobe,autobaud). The
	 * autobaud module (src/autobaud/autobaud.cpp) references these two nodes
	 * via DT_NODELABEL to obtain the two single-state pinctrl dev-configs:
	 * autobaud_pio routes uart1 RX (GP5) to PIO0 while measuring;
	 * autobaud_uart routes it back to UART1 on stop. rx-pin carries the RX
	 * GPIO number for the PIO SM config. No driver binds these; the binding
	 * exists only for the pinctrl + rx-pin DT codegen. */
	autobaud_pio: autobaud_pio {
		compatible = "debugprobe,autobaud";
		rx-pin = <5>;
		piodev = <&pio0>;
		pinctrl-0 = <&autobaud_pio_pins>;
		pinctrl-names = "default";
	};
	autobaud_uart: autobaud_uart {
		compatible = "debugprobe,autobaud";
		rx-pin = <5>;
		pinctrl-0 = <&autobaud_uart_pins>;
		pinctrl-names = "default";
	};

	/* The real Raspberry Pi Debug Probe (PROBE_IO_SWDI, per
	 * board_debug_probe_config.h): SWCLK=GP12, SWDIO output=GP14, separate
	 * SWDI input=GP13, no OEn, no nRESET pin. The PIO node carries a
	 * din-gpios for the separate input (driver use_swdi axis, still
	 * probe.pio). Exactly one backend is enabled: PIO is the default
	 * (CONFIG_PROBE_SWD_PIO=y); to use bitbang, flip both the Kconfig
	 * choice and these two status values.
	 */
	swd_bitbang: swd_bitbang {
		compatible = "zephyr,swdp-gpio";
		clk-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		port-write-cycles = <2>;
		status = "disabled";
	};

	swd_pio: swd_pio {
		compatible = "raspberrypi,swdp-pio";
		piodev = <&pio0>;
		pinctrl-0 = <&swd_pio_default>;
		pinctrl-names = "default";
		clk-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		din-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		swclk-pin = <12>;
		swdio-pin = <14>;
		status = "okay";
	};

	/* Status LEDs (gpio-leds nodes in the board DTS), matching the original
	 * debug-probe mapping: DAP_CONNECTED=GP15 (green_led_dbug),
	 * DAP_RUNNING=GP16 (yellow_led_dbug), USB=GP2 (red_led).
	 */
	aliases {
		dap-connected-led = &green_led_dbug;
		dap-running-led = &yellow_led_dbug;
		usb-connected-led = &red_led;
		uart-tx-led = &yellow_led_uart;
		uart-rx-led = &green_led_uart;
	};
};
