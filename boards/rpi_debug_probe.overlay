#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Route the Debug Probe's PIO SWD pins to PIO0 (the Zephyr way, via pinctrl).
 * SWCLK=GP12 (output), SWDIO=GP14 (output only -- the probe has a separate
 * input), SWDI=GP13 (the read pin: input-enable + pull-up).
 */
&pinctrl {
	swd_pio_default: swd_pio_default {
		clk_pins {
			pinmux = <PIO0_P12>;
		};
		dio_pins {
			pinmux = <PIO0_P14>;
		};
		din_pins {
			pinmux = <PIO0_P13>;
			input-enable;
			bias-pull-up;
		};
	};

	/* Console UART (uart0): TX=GP0, RX=GP1. The board defaults the console
	 * to uart1, but uart1 is the bridge target here, so the console moves to
	 * uart0 (chosen below) and needs its own pinctrl (the board DTS only
	 * defines uart1_default).
	 */
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_P0>, <UART0_RX_P1>;
		};
	};
};

/* Move the console/shell off uart1 (the board DTS chose uart1) so the bridge
 * owns uart1 exclusively, and enable uart0 as the console UART.
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Enable PIO0 so the misc PIO HAL (PIO_RPI_PICO) builds, which the dp_pio
 * driver compiles against, and so the raspberrypi,swdp-pio instance can run.
 */
&pio0 {
	status = "okay";
};

/ {
	/* uart1 is already enabled (status=okay, uart1_default pinctrl) in the
	 * board DTS and was the console -- move the console/shell to uart0 so the
	 * CDC-ACM <-> uart1 bridge owns uart1.
	 */
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	/* CDC-ACM (USB) <-> uart1 (target) bridge: Zephyr's zephyr,uart-bridge
	 * driver wires cdc_acm_uart0 to the hardware uart1 (already okay in the
	 * board DTS), copying bytes both ways and propagating line coding.
	 */
	uart_bridge0: uart-bridge0 {
		compatible = "zephyr,uart-bridge";
		peers = <&cdc_acm_uart0 &uart1>;
	};

	/* The real Raspberry Pi Debug Probe (PROBE_IO_SWDI, per
	 * board_debug_probe_config.h): SWCLK=GP12, SWDIO output=GP14, separate
	 * SWDI input=GP13, no OEn, no nRESET pin. The PIO node carries a
	 * din-gpios for the separate input (driver use_swdi axis, still
	 * probe.pio). Exactly one backend is enabled: PIO is the default
	 * (CONFIG_PROBE_SWD_PIO=y); to use bitbang, flip both the Kconfig
	 * choice and these two status values.
	 */
	swd_bitbang: swd_bitbang {
		compatible = "zephyr,swdp-gpio";
		clk-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		port-write-cycles = <2>;
		status = "disabled";
	};

	swd_pio: swd_pio {
		compatible = "raspberrypi,swdp-pio";
		piodev = <&pio0>;
		pinctrl-0 = <&swd_pio_default>;
		pinctrl-names = "default";
		clk-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		dio-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		din-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		swclk-pin = <12>;
		swdio-pin = <14>;
		status = "okay";
	};
};
